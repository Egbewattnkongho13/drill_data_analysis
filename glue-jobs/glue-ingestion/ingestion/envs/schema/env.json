{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ingestion Job Configuration",
  "description": "Configuration schema for the Kaggle ingestion Glue job",
  "type": "object",
  "required": ["environment", "job_name", "source", "sink", "destination"],
  "properties": {
    "environment": {
      "type": "string",
      "enum": ["dev", "qc", "prod"],
      "default": "dev",
      "description": "Deployment environment"
    },
    "job_name": {
      "type": "string",
      "default": "glue-job",
      "description": "Name of the Glue job"
    },
    "region": {
      "type": "string",
      "default": "us-east-1",
      "description": "AWS region"
    },
    "logging_level": {
      "type": "string",
      "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
      "default": "INFO",
      "description": "Logging level"
    },
    "timeout_seconds": {
      "type": "integer",
      "default": 3600,
      "minimum": 1,
      "description": "Job timeout in seconds"
    },
    "retry_attempts": {
      "type": "integer",
      "default": 3,
      "minimum": 0,
      "description": "Number of retry attempts on failure"
    },
    "source": {
      "type": "object",
      "required": ["type", "urls"],
      "properties": {
        "type": {
          "type": "string",
          "const": "kaggle",
          "description": "Source type (Kaggle)"
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://www\\.kaggle\\.com/"
          },
          "minItems": 1,
          "description": "List of Kaggle dataset URLs"
        }
      },
      "additionalProperties": false
    },
    "sink": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "s3"
            },
            "bucket_name": {
              "type": "string",
              "description": "S3 bucket name for output"
            }
          },
          "required": ["type", "bucket_name"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "local"
            },
            "path": {
              "type": "string",
              "description": "Local filesystem path for output"
            }
          },
          "required": ["type", "path"],
          "additionalProperties": false
        }
      ],
      "description": "Output sink configuration (S3 or local filesystem)"
    },
    "destination": {
      "type": "string",
      "description": "Destination path within the sink (e.g., 'raw/dev/glue_ingestion/')"
    }
  },
  "additionalProperties": false
}
